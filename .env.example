# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Secret key for browser sessions (use any long random string)
SESSION_SECRET=

# Set to true only when serving over HTTPS
SESSION_HTTPS_ONLY=false

# Max size of each uploaded CSV in bytes (default is 10 MB)
MAX_UPLOAD_BYTES=10485760

# Optional: only needed for the email export feature
SENDER_EMAIL=
SENDER_PASSWORD=
